{
  "name": "gymtrack",
  "private": true,
  "version": "2.0.0",
  "description": "Local-first workout tracker PWA: plan weekly gym days, log sets in one tap, see your progress.",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "tsc -b && eslint . && vitest run",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "pwa:screenshots": "node scripts/generate-pwa-screenshots.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "dexie": "^4.4.2",
    "dexie-react-hooks": "^4.4.0",
    "fuse.js": "^7.4.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.15.1",
    "tailwindcss": "^4.3.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1",
    "workbox-build": "^7.4.1"
  }
}
